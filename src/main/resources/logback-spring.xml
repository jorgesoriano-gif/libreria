<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback (Spring Boot): consola + archivo rotativo logs/libreria.log.
  Seguridad: no se registran contraseñas, hashes ni documentos de clientes.
-->
<configuration>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="PATRON" value="%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${PATRON}</pattern></encoder>
    </appender>

    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/libreria.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/libreria.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>5MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${PATRON}</pattern></encoder>
    </appender>

    <!-- Auditoría de accesos, ventas, compras e inventario -->
    <logger name="com.utp.libreria" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ARCHIVO"/>
    </root>
</configuration>
